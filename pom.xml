<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>43.0.0</version>
		<relativePath />
	</parent>

	<groupId>ch.epfl.biop</groupId>
	<artifactId>scijava-ui-robot</artifactId>
	<version>0.1.0-SNAPSHOT</version>

	<name>SciJava UI Robot</name>
	<description>A visible, recordable driver for SciJava commands — drives input
		harvesting (and, later, java.awt.Robot gestures) so command runs can be
		reproduced and recorded for tutorial videos. Developed by BIOP - EPFL.</description>
	<url>https://biop.epfl.ch</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>BIOP</name>
		<url>https://biop.epfl.ch</url>
	</organization>
	<licenses>
		<license>
			<name>Simplified BSD License</name>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>nicokiaru</id>
			<name>Nicolas Chiaruttini</name>
			<url>https://www.epfl.ch/research/facilities/ptbiop/staff/</url>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>Nicolas Chiaruttini</name>
			<url>http://biop.epfl.ch/INFO_Facility.html</url>
			<roles><role>founder</role></roles>
			<properties><id>NicoKiaru</id></properties>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/BIOP/scijava-ui-robot</connection>
		<developerConnection>scm:git:git@github.com:BIOP/scijava-ui-robot</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/BIOP/scijava-ui-robot</url>
	</scm>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/BIOP/scijava-ui-robot/issues</url>
	</issueManagement>

	<ciManagement>
		<system>None</system>
	</ciManagement>

	<properties>
		<package-name>ch.epfl.biop.scijava.ui.robot</package-name>
		<license.licenseName>bsd_2</license.licenseName>
		<license.copyrightOwners>EPFL</license.copyrightOwners>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<dependencies>
		<!-- Core: command model + parameter reflection. Deliberately minimal —
		     no BDV, no bdv-playground, no imagej-legacy. The visible-gesture and
		     binding layers (Robot, BDV, IJ1) are added in their own modules. -->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-common</artifactId>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
