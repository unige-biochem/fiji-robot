	<dependencies>
		<!-- Core: command model + parameter reflection. Deliberately minimal —
		     no BDV, no bdv-playground, no imagej-legacy. The visible-gesture and
		     binding layers (Robot, BDV, IJ1) are added in their own modules. -->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-common</artifactId>
		</dependency>

		<!-- The Swing input harvester this library drives. Required at runtime
		     for the visible widget layer (and the GUI tests) to produce dialogs;
		     a consumer that only uses programmatic mode does not need it active. -->
		<dependency>
			<groupId>org.scijava</groupId>
			<artifactId>scijava-ui-swing</artifactId>
		</dependency>

		<!-- ImageJ1 binding (package ch.unige.biochem.fiji.robot.ij1 only).
		     Pulls in ImageJ1 (ij.IJ, ij.WindowManager, ij.ImagePlus) and the
		     LegacyImagePreprocessor the active-image preset relies on. This is
		     the ONLY dependency the core packages must never touch — keeping the
		     ij1 code free-standing here is what makes a future module split a
		     matter of moving the package and this one dependency. -->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej-legacy</artifactId>
		</dependency>

		<!-- BigDataViewer-Playground binding (package
		     ch.unige.biochem.fiji.robot.bdv only). Provides the SourceService
		     source tree the tree-launcher drives, the ActiveBdvPreprocessor the
		     active-BDV preset relies on, BdvHandle, and the window helpers. Like
		     imagej-legacy, this is quarantined to one package so a future module
		     split moves the bdv package and this dependency together. The bdv
		     binding depends only on bdvpg's existing public API — no fork needed. -->
		<dependency>
			<groupId>sc.fiji</groupId>
			<artifactId>bigdataviewer-playground</artifactId>
			<version>0.21.0</version>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- The ImageJ gateway (new ImageJ().ui().showUI()) used only to boot a
		     real Fiji UI in the ij1 GUI tests. Heavyweight, hence test-scoped —
		     the ij1 main code drives the already-running IJ, it does not boot it. -->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
